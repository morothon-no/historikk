# Names only. NEVER put real values in this repository, PR, build context or logs.
# Stable identity/storage entries are generated once by the setup command.
MOROTHON_ADMIN_ORIGIN=https://admin.example.invalid
MOROTHON_OWNER_USER_ID=
MOROTHON_OWNER_GITHUB_ID=
MOROTHON_ADMIN_STORAGE_KEY=
MOROTHON_GITHUB_CLIENT_ID=
MOROTHON_GITHUB_CLIENT_SECRET=
# Only after separately approved publication activation:
MOROTHON_PUBLISH_APP_ID=
MOROTHON_PUBLISH_INSTALLATION_ID=
# Multiline PEM: set through the hosting provider's secret UI or secure stdin, never a CLI argument.
MOROTHON_PUBLISH_APP_PRIVATE_KEY=
