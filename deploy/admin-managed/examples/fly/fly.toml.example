# No launch/deploy runs automatically. Replace the app name only after owner approval.
app = "REPLACE-WITH-APP-NAME"
primary_region = "fra"
kill_signal = "SIGTERM"
kill_timeout = 120
[build]
  dockerfile = "Dockerfile"
[env]
  MOROTHON_ADMIN_MANAGED_HTTPS = "true"
  MOROTHON_ADMIN_VOLUME_ROOT = "/data"
  MOROTHON_ADMIN_PRIVATE_DIR = "/data/morothon"
  MOROTHON_PUBLISH_ENABLED = "false"
  PORT = "3000"
[[mounts]]
  source = "morothon_admin_data"
  destination = "/data"
[http_service]
  internal_port = 3000
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1
  [http_service.concurrency]
    type = "requests"
    soft_limit = 10
    hard_limit = 20
  [[http_service.checks]]
    interval = "30s"
    timeout = "5s"
    grace_period = "120s"
    method = "GET"
    path = "/admin-healthz"
    [http_service.checks.headers]
      Host = "REPLACE-WITH-APP-NAME.fly.dev"
[[vm]]
  cpu_kind = "shared"
  cpus = 2
  memory = "2gb"
[deploy]
  strategy = "immediate"
