{
  // Optional deployment adapter, not an active service. No paid plan is required.
  "name": "REPLACE-WITH-APP-NAME",
  "main": "../../scripts/admin/serverless/worker.mjs",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {"enabled": false},
  "ratelimits": [{"name": "AUTH_LIMITER", "namespace_id": "1001", "simple": {"limit": 5, "period": 60}}, {"name": "API_LIMITER", "namespace_id": "1002", "simple": {"limit": 60, "period": 60}}],
  "vars": {
    "API_ORIGIN": "https://REPLACE-WITH-APP-NAME.REPLACE-WITH-SUBDOMAIN.workers.dev",
    "PORTAL_URL": "https://historikk.morothon.no/admin/",
    "OWNER_USER_ID": "REPLACE-WITH-STABLE-INTERNAL-UUID",
    "OWNER_GITHUB_ID": "REPLACE-WITH-CONFIRMED-NUMERIC-ID",
    "OAUTH_CLIENT_ID": "REPLACE-WITH-CLIENT-ID",
    "GITHUB_APP_ID": "REPLACE-WITH-APP-ID",
    "GITHUB_INSTALLATION_ID": "REPLACE-WITH-INSTALLATION-ID",
    "PRIVATE_REPOSITORY": "morothon-no/historikk-admin",
    "PRIVATE_REPOSITORY_ID": "REPLACE-WITH-PRIVATE-REPOSITORY-NUMERIC-ID",
    "PRIVATE_WORKFLOW_SHA": "REPLACE-WITH-REVIEWED-PRIVATE-WORKFLOW-COMMIT",
    "PROCESSOR_CODE_SHA": "REPLACE-WITH-REVIEWED-PUBLIC-MAIN-COMMIT",
    "DISPATCH_ACTOR_ID": "REPLACE-WITH-APP-BOT-NUMERIC-ID"
  }
  // Secrets set separately: OAUTH_CLIENT_SECRET, GITHUB_APP_PRIVATE_KEY, STORAGE_KEY.
}
